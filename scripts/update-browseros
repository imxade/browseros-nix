#!/usr/bin/env bash
set -euo pipefail

repo="browseros-ai/BrowserOS"
api="https://api.github.com/repos/${repo}/releases"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source_file="${root}/source.nix"

if ! command -v jq >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  if command -v nix >/dev/null 2>&1; then
    exec nix develop "${root}" -c "$0" "$@"
  fi
fi

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'error: required command not found: %s\n' "$1" >&2
    exit 1
  fi
}

need curl
need jq
need nix
need python3

headers=(
  -H "Accept: application/vnd.github+json"
  -H "X-GitHub-Api-Version: 2022-11-28"
  -H "User-Agent: browseros-nix-updater"
)

if [[ -z "${GITHUB_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
fi

if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  headers+=( -H "Authorization: Bearer ${GITHUB_TOKEN}" )
fi

release=''
page=1

# The BrowserOS repository also publishes server/extension releases. Never use
# /releases/latest here. Select only a plain browser semver tag and require the
# exact Linux x64 AppImage asset for that same tag.
while (( page <= 20 )); do
  releases="$(
    curl \
      --fail \
      --silent \
      --show-error \
      --location \
      --retry 3 \
      "${headers[@]}" \
      "${api}?per_page=100&page=${page}"
  )"

  count="$(jq 'length' <<<"${releases}")"

  candidate="$(
    jq --compact-output '
      [
        .[]
        | select(.draft == false)
        | select(.prerelease == false)
        | select(.tag_name | test("^v[0-9]+[.][0-9]+[.][0-9]+$"))
        | . as $release
        | .assets[]?
        | select(.name == ("BrowserOS_" + $release.tag_name + "_x64.AppImage"))
        | {
            tag: $release.tag_name,
            url: .browser_download_url,
            digest: (.digest // "")
          }
      ][0] // empty
    ' <<<"${releases}"
  )"

  if [[ -n "${candidate}" ]]; then
    release="${candidate}"
    break
  fi

  if (( count < 100 )); then
    break
  fi

  ((page += 1))
done

if [[ -z "${release}" ]]; then
  printf '%s\n' \
    "error: no stable BrowserOS release with a matching x64 AppImage was found" >&2
  exit 1
fi

tag="$(jq --raw-output '.tag' <<<"${release}")"
version="${tag#v}"
url="$(jq --raw-output '.url' <<<"${release}")"
digest="$(jq --raw-output '.digest' <<<"${release}")"

expected_url="https://github.com/${repo}/releases/download/${tag}/BrowserOS_${tag}_x64.AppImage"
if [[ "${url}" != "${expected_url}" ]]; then
  printf 'error: unexpected BrowserOS asset URL\nexpected: %s\nactual:   %s\n' \
    "${expected_url}" "${url}" >&2
  exit 1
fi

hash=''
if [[ "${digest}" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
  hex="${digest#sha256:}"
  hash="$(
    python3 - "${hex}" <<'PY'
import base64
import sys

raw = bytes.fromhex(sys.argv[1])
print("sha256-" + base64.b64encode(raw).decode("ascii"))
PY
  )"
  printf 'Using GitHub release-asset SHA-256 digest for BrowserOS %s.\n' "${version}"
else
  printf '%s\n' \
    "GitHub did not expose a SHA-256 asset digest; prefetching with Nix." >&2
  hash="$(
    nix store prefetch-file \
      --json \
      --hash-type sha256 \
      "${url}" \
      | jq --raw-output '.hash'
  )"
fi

if [[ ! "${hash}" =~ ^sha256-[A-Za-z0-9+/]{43}=$ ]]; then
  printf 'error: invalid SRI SHA-256 produced: %s\n' "${hash}" >&2
  exit 1
fi

tmp="$(mktemp "${source_file}.XXXXXX")"
cleanup() {
  rm -f "${tmp}"
}
trap cleanup EXIT

cat >"${tmp}" <<EOF_SOURCE
# Generated by scripts/update-browseros. Do not edit by hand.
{
  version = "${version}";
  tag = "${tag}";
  url = "${url}";
  hash = "${hash}";
}
EOF_SOURCE

if cmp -s "${tmp}" "${source_file}"; then
  printf 'BrowserOS %s is already current.\n' "${version}"
else
  mv "${tmp}" "${source_file}"
  trap - EXIT
  printf 'Updated source.nix to BrowserOS %s.\n' "${version}"
fi
